# Настройки локального стенда APP.
#
# docker-compose читает этот файл сам (он подключён как env_file сервисов `db` и `api`),
# поэтому `docker-compose up -d --build` работает «из коробки».
# Для своего стенда скопируйте файл в `.env` и задайте свои значения —
# `.env` подключается вторым и переопределяет всё, что здесь написано.
#
#   copy .env.example .env      # Windows
#   cp .env.example .env        # bash
#
# Второму стенду того же compose-файла (например клону человека) нужны СВОИ имя проекта
# и порты: с общими он пересоздаст контейнеры первого. Пример для второго стенда:
#
#   COMPOSE_PROJECT_NAME=workflow-local
#   FRONTEND_PORT=8091
#   API_PORT=8092
#
# Ни одно из этих значений не должно использоваться на реальном стенде.

# --- PostgreSQL ---
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DB=workflow
# Если меняете POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, поправьте и строку ниже.
DATABASE_URL=postgresql+psycopg://workflow:workflow@db:5432/workflow

# --- Имя compose-проекта ---
# По нему docker-compose находит свои контейнеры и свой том базы.
COMPOSE_PROJECT_NAME=workflow-agent

# --- Порты стенда на хосте ---
FRONTEND_PORT=8095
API_PORT=8096
